{
  "name": "ensaio-de-danca",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Jogo de dança no navegador com MediaPipe, para jogar em casa.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint . && vitest run && vite build",
    "test:e2e": "playwright test --trace off",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "icons": "node scripts/make-icons.mjs",
    "gerar:sql": "node scripts/gerar-musicas-sql.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "idb": "8.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1"
  }
}
